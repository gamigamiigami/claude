{
  "name": "fusen-todo",
  "version": "1.0.0",
  "description": "ToDo丸(とどまる) - 付箋風TODOアプリ",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win --x64"
  },
  "build": {
    "appId": "com.fusen.todo",
    "productName": "FusenTodo",
    "directories": {
      "output": "dist-build"
    },
    "win": {
      "target": [
        { "target": "zip", "arch": ["x64"] }
      ]
    }
  },
  "devDependencies": {
    "electron": "^31.0.0",
    "electron-builder": "^26.15.2"
  }
}
